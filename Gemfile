source 'https://rubygems.org'

gem 'jekyll', '~> 4.4'
# Sass 2.x (libsass) compiles the theme's older SCSS as written; 3.x (Dart Sass) rejects parts of it
gem 'jekyll-sass-converter', '~> 2.2'
gem 'kramdown-parser-gfm'
# No longer bundled with Ruby 3.x
gem 'webrick'
gem 'csv'
gem 'base64'
gem 'bigdecimal'
gem 'logger'

group :jekyll_plugins do
    gem 'jekyll-email-protect'
    gem 'jekyll-paginate'
    gem 'jekyll-scholar'
    gem 'jemoji'
    gem 'unicode_utils'
end
